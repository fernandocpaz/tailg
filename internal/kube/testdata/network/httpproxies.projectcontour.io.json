{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "metadata": {
        "name": "root",
        "namespace": "apollo"
      },
      "spec": {
        "virtualhost": {
          "fqdn": "proxy.test",
          "tls": {
            "secretName": "web-tls"
          }
        },
        "includes": [
          {
            "name": "child",
            "conditions": [
              {
                "prefix": "/api"
              }
            ]
          }
        ]
      },
      "status": {
        "currentStatus": "valid"
      }
    },
    {
      "metadata": {
        "name": "child",
        "namespace": "apollo"
      },
      "spec": {
        "routes": [
          {
            "conditions": [
              {
                "prefix": "/v1"
              }
            ],
            "services": [
              {
                "name": "api",
                "port": 80
              }
            ]
          }
        ]
      },
      "status": {
        "currentStatus": "valid"
      }
    }
  ]
}
