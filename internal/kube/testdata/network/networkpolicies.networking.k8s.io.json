{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "metadata": {
        "name": "api-policy",
        "namespace": "apollo"
      },
      "spec": {
        "podSelector": {
          "matchExpressions": [
            {
              "key": "app",
              "operator": "In",
              "values": [
                "api"
              ]
            }
          ]
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
